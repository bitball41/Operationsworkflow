{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operationsworkflow",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker owns routing for anything that is not a file on disk, so it
    // can serve /api/* itself instead of the asset layer swallowing it as an
    // SPA fallback. worker/index.js falls back to index.html for page GETs.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEMO_DOMAIN": "demos.conno.fun"
  },
  // Cloudflare Browser Run powers the assistant's public-page research tool.
  "browser": {
    "binding": "BROWSER"
  },
  // Create once before the first production deploy:
  //   npx wrangler r2 bucket create operationsworkflow-demos
  "r2_buckets": [
    {
      "binding": "DEMO_SITES",
      "bucket_name": "operationsworkflow-demos"
    }
  ],
  // OAuth state and encrypted per-user Outlook tokens.
  //
  // This binding must resolve to a real namespace or every Outlook route
  // answers 503 with OUTLOOK_TOKENS in the missing list — the connection can
  // never be stored. Wrangler can provision a namespace during an interactive
  // `wrangler deploy`, but a CI or dashboard build has nobody to answer the
  // prompt, so create it once and paste the id here:
  //
  //   npx wrangler kv namespace create OUTLOOK_TOKENS
  //
  // and set the id below. `/api/status` reports the binding as missing until
  // then, and Integrations names it on screen.
  "kv_namespaces": [
    {
      "binding": "OUTLOOK_TOKENS"
      // "id": "<paste the id from `wrangler kv namespace create` here>"
    }
  ]
}
