{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operationsworkflow",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker owns routing for anything that is not a file on disk, so it
    // can serve /api/* itself instead of the asset layer swallowing it as an
    // SPA fallback. worker/index.js falls back to index.html for page GETs.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // OAuth state and encrypted per-user Outlook tokens. Wrangler provisions the
  // namespace on deploy when no id is present.
  "kv_namespaces": [
    {
      "binding": "OUTLOOK_TOKENS"
    }
  ]
}
