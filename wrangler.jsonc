{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operationsworkflow",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker owns routing for anything that is not a file on disk, so it
    // can serve /api/* itself instead of the asset layer swallowing it as an
    // SPA fallback. It must run first on every request because the public demo
    // hostname shares this Worker but must never fall through to dashboard
    // assets. worker/index.js fetches ASSETS for the private dashboard.
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEMO_DOMAIN": "demos.conno.fun",
    "WHOP_WEBHOOK_DOMAIN": "hooks.conno.fun",
    "OPERATIONS_WORKSPACE_ID": "2847b8e2-8a34-4a72-8e44-2cfc1be4255b",
    "CF_ACCESS_TEAM_DOMAIN": "https://openscout-pages.cloudflareaccess.com",
    "CF_ACCESS_AUD": "8cb2b052dc81e5cf1b6e74eefa600e1d610f7346712d0582f3447475140c867e"
  },
  "routes": [
    { "pattern": "operations.conno.fun", "custom_domain": true },
    { "pattern": "demos.conno.fun", "custom_domain": true },
    { "pattern": "hooks.conno.fun", "custom_domain": true }
  ],
  // Cloudflare Browser Run powers the assistant's public-page research tool.
  "browser": {
    "binding": "BROWSER"
  },
  // Create once before the first production deploy:
  //   npx wrangler r2 bucket create operationsworkflow-demos
  "r2_buckets": [
    {
      "binding": "DEMO_SITES",
      "bucket_name": "operationsworkflow-demos"
    }
  ],
  // OAuth state and encrypted Outlook tokens for the one Operations workspace.
  //
  // This is the existing operationsworkflow-outlook-tokens namespace. Keeping
  // its id in configuration lets unattended Git builds bind it without an
  // interactive provisioning prompt.
  "kv_namespaces": [
    {
      "binding": "OUTLOOK_TOKENS",
      "id": "ce079aae33bc4b2882a527b1e2617da0"
    }
  ]
}
