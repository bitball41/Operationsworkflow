# Local Worker secrets. Copy to .dev.vars (git-ignored) for `wrangler dev`.
# In production these are Worker secrets, not variables:
#
#   wrangler secret put ANTHROPIC_API_KEY
#   wrangler secret put OPENAI_API_KEY
#   wrangler secret put WHOP_WEBHOOK_SECRET
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   wrangler secret put WHOP_OWNER_USER_ID
#   wrangler secret put GOOGLE_MAPS_API_KEY
#   wrangler secret put MICROSOFT_CLIENT_ID
#   wrangler secret put MICROSOFT_CLIENT_SECRET
#   wrangler secret put OUTLOOK_TOKEN_ENCRYPTION_KEY
#   wrangler secret put MCP_API_TOKEN
#
# Never commit real values. Every key below is read only inside the Worker.

# Anthropic — the assistant and automation model provider.
ANTHROPIC_API_KEY=

# OpenAI — alternate model provider. Optional if Anthropic is set.
OPENAI_API_KEY=

# Whop — signed webhook delivery only. Set this to the signing secret Whop
# shows after creating https://hooks.conno.fun/whop with API version v1.
WHOP_WEBHOOK_SECRET=
# Server-only Supabase key for the webhook RPC. Never put this in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# The single Operations workspace owner id; created from existing Whop data.
WHOP_OWNER_USER_ID=

# Google Maps — lead discovery. This one reaches the browser, because the Maps
# JavaScript SDK runs in the page. Restrict it by HTTP referrer in Google Cloud
# and enable only "Maps JavaScript API" and "Places API (New)".
GOOGLE_MAPS_API_KEY=

# Outlook — Microsoft Entra confidential web app. `common` supports personal
# Microsoft accounts and work/school accounts. The callback URI is derived from
# the origin serving the Worker: /api/outlook/callback.
#
# The app registration needs delegated Mail.Send AND Mail.Read. Mail.Send alone
# gives a write-only mailbox: outreach goes out, no reply ever comes back, and
# the Inbox stays permanently empty.
#
# Sending also needs the OUTLOOK_TOKENS KV namespace to exist — see
# wrangler.jsonc. It stores each user's encrypted tokens; with no namespace
# bound there is nowhere to keep a connection and every route answers 503.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Any high-entropy value of at least 32 characters. The Worker derives an
# AES-GCM key from it before storing OAuth tokens in OUTLOOK_TOKENS KV.
OUTLOOK_TOKEN_ENCRYPTION_KEY=

# MCP — bearer token for https://operations.conno.fun/mcp. Cloudflare Access
# should protect the host too; this token keeps the endpoint closed if an Access
# policy is ever detached. Generate a random value and never put it in browser
# code or source.
MCP_API_TOKEN=
